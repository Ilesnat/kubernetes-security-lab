# ==========================================================================
# k8s-sec-lab environment configuration  ->  copy to .env (which is gitignored)
#   cp .env.example .env      (bash)
#   Copy-Item .env.example .env   (PowerShell)
# Scripts read .env. NEVER commit .env. Override any default below as needed.
# ==========================================================================

# Which cluster backend the scripts target by default: kind | aks
BACKEND=kind

# ---------------------------------------------------------------------------
# LOCAL (kind) settings
# ---------------------------------------------------------------------------
KIND_CLUSTER_NAME=k8s-sec-lab
# nodes: "multi" = 1 control-plane + 2 workers, "single" = 1 node (low-RAM machines)
KIND_NODES=multi

# ---------------------------------------------------------------------------
# AZURE (aks) settings -- used only by the AKS backend
# ---------------------------------------------------------------------------
# Your personal subscription. Scripts FAIL FAST if the active
# `az account show` subscription id does not match this value.
# Put your REAL values in .env (gitignored) -- never in this committed template.
AKS_SUBSCRIPTION_ID=<your-subscription-guid>
AKS_TENANT=<your-tenant>.onmicrosoft.com

# Single dedicated resource group -> one `az group delete` tears down EVERYTHING.
AKS_RESOURCE_GROUP=rg-k8s-sec-lab
AKS_LOCATION=eastus
AKS_CLUSTER_NAME=k8s-sec-lab
AKS_KUBECONFIG_CONTEXT=k8s-sec-lab

# Current AKS backend constraint: exactly one Standard_B4ms node. Standard_B2s
# has only 8 GiB of local temp storage and cannot host the 30-GiB ephemeral OS
# disk required by the Ubuntu image. Other sizes fail preflight.
AKS_NODE_SIZE=Standard_B4ms
AKS_NODE_COUNT=1
AKS_NODE_OS_DISK_TYPE=Ephemeral
AKS_NODE_OS_DISK_SIZE_GB=30

# Your public IP in CIDR form (e.g. 203.0.113.7/32). The API server and any
# exposed service are locked to THIS ONLY. Never 0.0.0.0/0.
# Find it:  (Invoke-RestMethod https://api.ipify.org) + "/32"
ALLOWED_IP=

# Guaranteed teardown even if you forget. Hours before auto-destroy fires.
AUTO_DESTROY_HOURS=3
